rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default: browsers can't touch anything. Cloud Functions use the Admin SDK, which bypasses rules.
    match /{document=**} {
      allow read, write: if false;
    }

    // The host panel (/host.html) signs in with a token that carries the custom claim host == true.
    // Only a trusted server (Admin SDK) can mint such a token, and the Auth emulator accepts an unsigned one,
    // so in production nobody can write these fields from a browser; locally the PoC panel can.
    function isHost() {
      return request.auth != null && request.auth.token.host == true;
    }

    // Live shopping: anonymous visitors may read, chat and vote, nothing else.
    match /lives/{liveId} {
      allow read: if true;

      // Host only, and only these two fields: start/end the live, pin a product (or null to unpin).
      allow update: if isHost()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'pinnedProduct'])
        && request.resource.data.status in ['live', 'scheduled', 'ended']
        && (request.resource.data.get('pinnedProduct', null) == null
            || (request.resource.data.pinnedProduct is string && request.resource.data.pinnedProduct.matches('^[A-Za-z0-9_-]{1,255}$')));

      match /messages/{messageId} {
        allow read: if true;
        allow delete: if isHost(); // moderation
        allow create: if request.resource.data.keys().hasOnly(['name', 'text', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 24
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
          && request.resource.data.at == request.time; // server clock only, so nobody can fake ordering
      }

      // Presence: each open player writes its own heartbeat doc (id = session id) every 30 s. The widget counts docs seen in the last 75 s.
      // No auth, so anyone can delete a heartbeat; that can only lower a counter. Real presence would use RTDB onDisconnect.
      match /viewers/{sessionId} {
        allow read: if true;
        allow create, update: if sessionId.matches('^[A-Za-z0-9_-]{1,64}$')
          && request.resource.data.keys().hasOnly(['lastSeen'])
          && request.resource.data.lastSeen == request.time;
        allow delete: if sessionId.matches('^[A-Za-z0-9_-]{1,64}$');
      }

      // Hearts: create-only, one document per flushed batch (the client sends at most one per second).
      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['type', 'count', 'sessionId', 'at'])
          && request.resource.data.type == 'heart'
          && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 20
          && request.resource.data.sessionId is string && request.resource.data.sessionId.size() <= 64
          && request.resource.data.at == request.time;
      }

      // One doc per voter (id = session id) and create-only: that is what stops changing a vote.
      // A new session id can vote again; real prevention needs auth. See README.
      match /votes/{sessionId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['option'])
          && request.resource.data.option is string && request.resource.data.option.size() <= 32;
      }
    }
  }
}
